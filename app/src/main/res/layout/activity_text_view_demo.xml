<?xml version="1.0" encoding="utf-8"?>
<!--
  页面①：TextView 属性演示
  结构：ScrollView（内容超出屏幕可上下滚动）
        └ LinearLayout（所有卡片竖着排队）
            └ 每张"白色卡片"是一个白色背景的 LinearLayout，
              里面第一行是灰色小字说明，下面是实际效果控件。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 页面大标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TextView 属性演示"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- ===== 卡片1：layout_width / layout_height / id ===== -->
        <!-- match_parent=撑满父容器；wrap_content=刚好包住内容 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="① layout_width/height 决定宽高：match_parent 铺满 / wrap_content 包内容；id 是控件的唯一编号，供 Java 里 findViewById 查找"
                android:textSize="12sp"
                android:textColor="#888888" />
            <!-- 蓝色条：宽度铺满整行（match_parent 的效果） -->
            <TextView
                android:id="@+id/tv_match"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="match_parent：我占满整行宽度"
                android:background="#E3F2FD"
                android:padding="8dp"
                android:layout_marginTop="8dp" />
            <!-- 红色条：宽度刚好包住文字（wrap_content 的效果） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="wrap_content：我刚好包住文字"
                android:background="#FCEBEB"
                android:padding="8dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- ===== 卡片2：text / textSize / textColor ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="② text=显示的内容  textSize=文字大小（推荐单位 sp）  textColor=文字颜色（#RRGGBB）"
                android:textSize="12sp"
                android:textColor="#888888" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我是 20sp 的红色文字"
                android:textSize="20sp"
                android:textColor="#E53935"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- ===== 卡片3：background（含半透明） ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="③ background=背景色。颜色可写 8 位：前两位是透明度，80 表示半透明"
                android:textSize="12sp"
                android:textColor="#888888" />
            <!-- 6 位颜色：不透明绿色背景 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="不透明背景 #4CAF50"
                android:background="#4CAF50"
                android:padding="8dp"
                android:layout_marginTop="8dp" />
            <!-- 8 位颜色：前两位 80=半透明，能隐约透出底下的灰色页面背景 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="半透明背景 #804CAF50"
                android:background="#804CAF50"
                android:padding="8dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- ===== 卡片4：layout_margin 与 padding ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="④ 口诀：margin 管外（控件和别人之间的距离），padding 管内（内容和控件边框的距离）"
                android:textSize="12sp"
                android:textColor="#888888" />
            <!-- padding=16dp：文字离橙色块自己的边缘有 16dp 内部空隙 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="padding=16dp：文字离橙色边框 16dp"
                android:background="#FF9800"
                android:padding="16dp"
                android:layout_marginTop="8dp" />
            <!-- layout_margin=24dp：这个控件整体和周围（卡片边缘）隔了 24dp 外部空隙 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="margin=24dp：我和卡片边缘隔了 24dp"
                android:background="#03A9F4"
                android:padding="8dp"
                android:layout_margin="24dp" />
        </LinearLayout>

        <!-- ===== 卡片5：gravity ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⑤ gravity=内容在控件里的位置。管内容的是 gravity；管控件自己在父容器位置的是 layout_gravity"
                android:textSize="12sp"
                android:textColor="#888888" />
            <!-- 三个固定高度的 TextView，文字分别靠左 / 居中 / 靠右 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="gravity=left"
                android:gravity="left"
                android:background="#E3F2FD"
                android:layout_marginTop="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="gravity=center"
                android:gravity="center"
                android:background="#E8F5E9"
                android:layout_marginTop="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="gravity=right"
                android:gravity="right"
                android:background="#FFF3E0"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- ===== 卡片6：maxLength ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⑥ maxLength=5：文字再长也只显示前 5 个字（超出的直接不显示）"
                android:textSize="12sp"
                android:textColor="#888888" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="一二三四五六七八九十"
                android:maxLength="5"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- ===== 卡片7：lines 与 maxLines ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⑦ lines=2 固定占两行高（内容只有一行也占两行）；maxLines=2 最多显示两行，超出的截断"
                android:textSize="12sp"
                android:textColor="#888888" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="lines=2：我只占一行，但高度仍是两行"
                android:lines="2"
                android:background="#E3F2FD"
                android:layout_marginTop="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="maxLines=2：这段文字很长很长很长很长很长很长很长很长很长很长，超出的部分不显示"
                android:maxLines="2"
                android:background="#FFF3E0"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- ===== 卡片8：ellipsize 三法并排 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⑧ ellipsize：超出时的省略号位置 —— start 头部 / middle 中间 / end 尾部（三个并排对比）"
                android:textSize="12sp"
                android:textColor="#888888" />
            <!-- 横向 LinearLayout，三个 TextView 用 weight=1 平分宽度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">
                <!-- 宽度写 0dp + weight=1 是"平分剩余宽度"的标准写法 -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="这是一段很长很长很长的测试文字"
                    android:maxLines="1"
                    android:ellipsize="start"
                    android:background="#E3F2FD"
                    android:layout_marginRight="6dp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="这是一段很长很长很长的测试文字"
                    android:maxLines="1"
                    android:ellipsize="middle"
                    android:background="#E8F5E9"
                    android:layout_marginRight="6dp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="这是一段很长很长很长的测试文字"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:background="#FFF3E0" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 卡片9：drawableTop 矢量图标 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⑨ drawableTop：在文字上方画一个图标（还有 Bottom/Left/Right 三个方向），图标放 res/drawable 里，用 @drawable/文件名 调用"
                android:textSize="12sp"
                android:textColor="#888888" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="收藏"
                android:drawableTop="@drawable/ic_star"
                android:drawablePadding="4dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- ===== 卡片10：lineSpacingExtra ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⑩ lineSpacingExtra：行与行之间额外加的间距，越大越松"
                android:textSize="12sp"
                android:textColor="#888888" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="没有行间距：第一行内容，第二行内容，第三行内容，挤在一起"
                android:background="#E3F2FD"
                android:layout_marginTop="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="lineSpacingExtra=12dp：第一行内容，第二行内容，第三行内容，明显松了很多"
                android:lineSpacingExtra="12dp"
                android:background="#E8F5E9"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- ===== 卡片11：textStyle ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⑪ textStyle：normal 正常 / bold 加粗 / italic 倾斜"
                android:textSize="12sp"
                android:textColor="#888888" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="normal 正常字体"
                android:textSize="16sp"
                android:layout_marginTop="8dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="bold 加粗字体"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="italic 倾斜字体"
                android:textSize="16sp"
                android:textStyle="italic"
                android:layout_marginTop="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
